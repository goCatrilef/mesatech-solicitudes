# Copia este archivo como ".env" (junto al pom.xml) y completa los valores reales.
# El archivo ".env" real NO se sube al repositorio (esta en .gitignore).

# RDS exclusivo de Solicitudes (otra instancia RDS distinta a la de Catalogo)
DB_HOST=solicitudes-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=mesatech_solicitudes
DB_USERNAME=solicitudes_app
DB_PASSWORD=cambiar-por-clave-real

# RabbitMQ en la EC2 C (IP privada). Usuario con permiso de lectura solo sobre solicitudes.catalogo.queue
RABBITMQ_HOST=10.0.0.10
RABBITMQ_PORT=5672
RABBITMQ_VHOST=mesatech
RABBITMQ_USERNAME=mesatech_consumidor
RABBITMQ_PASSWORD=cambiar-por-clave-real

RABBITMQ_QUEUE=solicitudes.catalogo.queue

SERVER_PORT=8082
